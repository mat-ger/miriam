{
  "name": "miriam-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "predev": "node scripts/optimize-images.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/optimize-images.mjs",
    "build": "next build",
    "start": "serve out -l tcp://127.0.0.1:4173",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/export.test.mjs",
    "static": "npm run build && touch ./out/.nojekyll && echo 'www.gertz.at' > ./out/CNAME",
    "deploy": "gh-pages -d out -t true"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19",
    "react-dom": "^19",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cheerio": "^1.2.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "gh-pages": "^6.1.1",
    "serve": "^14.2.7",
    "typescript": "^5"
  },
  "overrides": {
    "serve": {
      "compression": "1.8.2"
    }
  }
}
